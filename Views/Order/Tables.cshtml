@model List<CafeManager.Models.CafeTable>
@{
    ViewData["Title"] = "Sơ đồ bàn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-grid-3x3-gap-fill text-warning me-2"></i>Sơ đồ bàn</h3>
        <p class="text-muted mb-0">Chọn một bàn để gọi món hoặc thanh toán</p>
    </div>
    <div class="d-flex gap-3 align-items-center">
        <span class="d-flex align-items-center gap-1 small text-muted">
            <span class="badge bg-success rounded-circle p-1"> </span> Bàn trống (@Model.Count(t => t.Status == TableStatus.Empty))
        </span>
        <span class="d-flex align-items-center gap-1 small text-muted">
            <span class="badge bg-warning rounded-circle p-1"> </span> Đang phục vụ (@Model.Count(t => t.Status == TableStatus.Serving))
        </span>
    </div>
</div>

<div class="row g-4">
    @foreach (var table in Model)
    {
        var isOccupied = table.Status == TableStatus.Serving;
        <div class="col-6 col-sm-4 col-md-3 col-lg-2">
            <a asp-action="Open" asp-route-tableId="@table.Id" class="text-decoration-none">
                <div class="card card-custom text-center p-3 h-100 position-relative @(isOccupied ? "border-warning border-2 bg-warning bg-opacity-10" : "bg-white")">
                    <div class="mb-2">
                        <i class="bi bi-cup-hot @(isOccupied ? "text-warning" : "text-success")" style="font-size: 2.2rem;"></i>
                    </div>
                    <h5 class="fw-bold mb-1 text-dark">@table.Name</h5>
                    <div>
                        @if (isOccupied)
                        {
                            <span class="badge bg-warning text-dark px-2 py-1">Có khách</span>
                        }
                        else
                        {
                            <span class="badge bg-success px-2 py-1">Trống</span>
                        }
                    </div>
                </div>
            </a>
        </div>
    }
</div>
