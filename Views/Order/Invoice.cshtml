@model CafeManager.Models.Order
@{
    ViewData["Title"] = $"Hóa đơn #{Model.Id}";
}

<div class="row justify-content-center py-4">
    <div class="col-md-7 col-lg-5">
        <div class="card card-custom p-4 bg-white border">
            <!-- Header Hóa đơn -->
            <div class="text-center border-bottom pb-3 mb-3">
                <i class="bi bi-cup-hot-fill text-warning fs-1"></i>
                <h4 class="fw-bold mb-1">CAFE MANAGER</h4>
                <p class="small text-muted mb-1">Địa chỉ: 123 Đường Cà Phê, Quận 1, TP. HCM</p>
                <p class="small text-muted mb-0">Hotline: 0909 123 456</p>
            </div>

            <div class="text-center mb-3">
                <h5 class="fw-bold text-success mb-1">HÓA ĐƠN THANH TOÁN</h5>
                <span class="badge bg-light text-dark border">Mã đơn: #@Model.Id</span>
            </div>

            <div class="small text-muted mb-3">
                <div class="d-flex justify-content-between">
                    <span>Bàn phục vụ:</span>
                    <strong class="text-dark">@(Model.Table?.Name ?? "Mang đi")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Thời gian:</span>
                    <span class="text-dark">@Model.CreatedAt.ToString("HH:mm:ss dd/MM/yyyy")</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Phương thức:</span>
                    <span class="badge bg-secondary">@Model.PaymentMethod</span>
                </div>
            </div>

            <!-- Bảng chi tiết món -->
            <table class="table table-sm border-top border-bottom small mb-3">
                <thead>
                    <tr class="text-muted">
                        <th>Tên món</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-end">Tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@(item.MenuItem?.Name ?? "Món")</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">@item.UnitPrice.ToString("N0")</td>
                            <td class="text-end fw-semibold">@((item.Quantity * item.UnitPrice).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Tổng tiền -->
            @{
                var subtotal = Model.Items.Sum(i => i.Quantity * i.UnitPrice);
            }
            <div class="small mb-3">
                <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Tổng cộng:</span>
                    <span>@subtotal.ToString("N0") đ</span>
                </div>
                @if (Model.Discount > 0)
                {
                    <div class="d-flex justify-content-between mb-1 text-danger">
                        <span>Giảm giá:</span>
                        <span>-@Model.Discount.ToString("N0") đ</span>
                    </div>
                }
                <div class="d-flex justify-content-between fs-5 fw-bold border-top pt-2 text-dark">
                    <span>THANH TOÁN:</span>
                    <span class="text-danger">@Model.Total.ToString("N0") đ</span>
                </div>
            </div>

            <div class="text-center text-muted small my-3 border-top pt-3">
                <em>Cảm ơn Quý khách và hẹn gặp lại!</em>
            </div>

            <div class="d-flex gap-2 d-print-none mt-2">
                <button onclick="window.print()" class="btn btn-outline-dark flex-grow-1">
                    <i class="bi bi-printer me-1"></i> In hóa đơn
                </button>
                <a asp-action="Tables" class="btn btn-cafe flex-grow-1">
                    <i class="bi bi-arrow-return-left me-1"></i> Về sơ đồ bàn
                </a>
            </div>
        </div>
    </div>
</div>
