@model List<CafeManager.Models.Order>
@{
    ViewData["Title"] = "Lịch sử hóa đơn";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-clock-history text-warning me-2"></i>Lịch sử hóa đơn đã thanh toán</h3>
        <p class="text-muted mb-0">Tổng số: @Model.Count đơn hàng - Doanh thu: <strong class="text-success">@Model.Sum(o => o.Total).ToString("N0") đ</strong></p>
    </div>
</div>

<div class="card card-custom p-3">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-receipt fs-1 d-block mb-2 opacity-50"></i>
            <span>Chưa có hóa đơn thanh toán nào được ghi nhận.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Bàn</th>
                        <th>Thời gian</th>
                        <th>Hình thức</th>
                        <th class="text-end">Giảm giá</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">#@order.Id</span></td>
                            <td class="fw-semibold">@(order.Table?.Name ?? "Mang đi")</td>
                            <td>@order.CreatedAt.ToString("HH:mm - dd/MM/yyyy")</td>
                            <td>
                                <span class="badge bg-light text-dark border">@order.PaymentMethod</span>
                            </td>
                            <td class="text-end text-muted">@order.Discount.ToString("N0") đ</td>
                            <td class="text-end fw-bold text-success">@order.Total.ToString("N0") đ</td>
                            <td class="text-center">
                                <a asp-action="Invoice" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye me-1"></i> Xem hóa đơn
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
