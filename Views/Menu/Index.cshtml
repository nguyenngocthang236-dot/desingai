@model List<CafeManager.Models.MenuItem>
@{
    ViewData["Title"] = "Quản lý thực đơn";
    var categories = ViewBag.Categories as List<CafeManager.Models.Category> ?? new();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h3 class="fw-bold mb-1"><i class="bi bi-journal-text text-warning me-2"></i>Thực đơn quán</h3>
        <p class="text-muted mb-0">Quản lý và cập nhật danh sách các món đồ uống & bánh</p>
    </div>
    @if (User.IsInRole("Manager"))
    {
        <div>
            <a asp-action="Create" class="btn btn-cafe">
                <i class="bi bi-plus-circle me-1"></i> Thêm món mới
            </a>
        </div>
    }
</div>

<!-- Lọc & Tìm kiếm -->
<div class="card card-custom p-3 mb-4">
    <form method="get" asp-action="Index" class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" name="q" class="form-control" placeholder="Tìm theo tên món..." value="@Context.Request.Query["q"]" />
            </div>
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                <option value="">-- Tất cả danh mục --</option>
                @foreach (var c in categories)
                {
                    var isSelected = Context.Request.Query["categoryId"] == c.Id.ToString();
                    <option value="@c.Id" selected="@isSelected">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Lọc</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
        </div>
    </form>
</div>

<!-- Danh sách món -->
<div class="card card-custom p-3">
    @if (!Model.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-cup fs-1 d-block mb-2 opacity-50"></i>
            <span>Không tìm thấy món nào phù hợp.</span>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Tên món</th>
                        <th>Danh mục</th>
                        <th>Giá bán</th>
                        <th>Mô tả</th>
                        <th>Trạng thái</th>
                        @if (User.IsInRole("Manager"))
                        {
                            <th class="text-end">Hành động</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td><span class="badge bg-light text-dark border">@(item.Category?.Name ?? "Chưa phân loại")</span></td>
                            <td class="fw-bold text-danger">@item.Price.ToString("N0") đ</td>
                            <td class="small text-muted" style="max-width: 250px;">@(string.IsNullOrEmpty(item.Description) ? "-" : item.Description)</td>
                            <td>
                                @if (item.IsAvailable)
                                {
                                    <span class="badge bg-success">Còn hàng</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Hết hàng</span>
                                }
                            </td>
                            @if (User.IsInRole("Manager"))
                            {
                                <td class="text-end">
                                    <div class="d-inline-flex gap-1">
                                        <form method="post" asp-action="Toggle" asp-route-id="@item.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm @(item.IsAvailable ? "btn-outline-warning" : "btn-outline-success")" title="Đổi trạng thái">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa món này?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
