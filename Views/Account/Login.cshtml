@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-12 col-sm-8 col-md-6 col-lg-4">
        <div class="card card-custom p-4 border-0">
            <div class="text-center mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-warning bg-opacity-25 rounded-circle p-3 mb-3" style="width: 72px; height: 72px;">
                    <i class="bi bi-cup-hot-fill text-warning fs-1"></i>
                </div>
                <h3 class="fw-bold text-dark">Đăng Nhập</h3>
                <p class="text-muted small">Hệ thống quản lý quán Cà Phê</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2 small d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div>@ViewBag.Error</div>
                </div>
            }

            <form method="post" asp-action="Login">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên đăng nhập</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-person"></i></span>
                        <input type="text" name="username" class="form-control" placeholder="Nhập tài khoản (vd: admin)" required autofocus />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                        <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu (vd: admin123)" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-cafe w-100 py-2 fs-6">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                </button>
            </form>

            <div class="mt-4 pt-3 border-top small text-muted">
                <div class="fw-bold mb-1">Tài khoản mặc định:</div>
                <ul class="list-unstyled mb-0">
                    <li>👑 <strong>Quản lý:</strong> <code>admin</code> / <code>admin123</code></li>
                    <li>💵 <strong>Thu ngân:</strong> <code>cashier</code> / <code>123456</code></li>
                    <li>☕ <strong>Nhân viên:</strong> <code>staff</code> / <code>123456</code></li>
                </ul>
            </div>
        </div>
    </div>
</div>
