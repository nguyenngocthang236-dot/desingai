<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cafe Manager</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --cafe-primary: #5c3d2e;
            --cafe-primary-hover: #482f23;
            --cafe-accent: #b85d19;
            --cafe-light: #fcf8f2;
            --cafe-dark: #2d1e18;
            --cafe-cream: #f4ece1;
        }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f7f6f2;
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .navbar-cafe {
            background: linear-gradient(135deg, #3d271d 0%, #5c3d2e 100%);
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        }
        .navbar-brand {
            font-weight: 700;
            letter-spacing: 0.5px;
            color: #fcebd9 !important;
        }
        .nav-link {
            color: rgba(255,255,255,0.85) !important;
            font-weight: 500;
            padding: 8px 16px !important;
            border-radius: 8px;
            transition: all 0.2s ease;
        }
        .nav-link:hover, .nav-link.active {
            color: #fff !important;
            background-color: rgba(255,255,255,0.15);
        }
        .card-custom {
            border: none;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .card-custom:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(0,0,0,0.08);
        }
        .btn-cafe {
            background-color: var(--cafe-primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-cafe:hover {
            background-color: var(--cafe-primary-hover);
            color: white;
        }
        .badge-role {
            font-size: 0.75rem;
            padding: 4px 8px;
            border-radius: 20px;
        }
        .footer-cafe {
            margin-top: auto;
            background: #2b1d16;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            padding: 16px 0;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-cafe">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" href="/">
                    <i class="bi bi-cup-hot-fill text-warning fs-4"></i>
                    <span>Cafe Manager</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="Tables">
                                    <i class="bi bi-grid-3x3-gap-fill me-1"></i> Sơ đồ bàn
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Menu" asp-action="Index">
                                    <i class="bi bi-journal-text me-1"></i> Thực đơn
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Order" asp-action="History">
                                    <i class="bi bi-receipt-cutoff me-1"></i> Lịch sử hóa đơn
                                </a>
                            </li>
                        </ul>
                        <div class="d-flex align-items-center gap-3">
                            <span class="text-light">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                                @if (User.IsInRole("Manager"))
                                {
                                    <span class="badge bg-danger badge-role ms-1">Quản lý</span>
                                }
                                else if (User.IsInRole("Cashier"))
                                {
                                    <span class="badge bg-warning text-dark badge-role ms-1">Thu ngân</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark badge-role ms-1">Nhân viên</span>
                                }
                            </span>
                            <a class="btn btn-outline-light btn-sm px-3" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right me-1"></i> Đăng xuất
                            </a>
                        </div>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="btn btn-warning btn-sm px-3 fw-bold" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container-fluid px-4 py-4">
        @RenderBody()
    </main>

    <footer class="footer-cafe text-center">
        <div class="container">
            <span>&copy; @DateTime.Now.Year CafeManager - Hệ thống quản lý quán cà phê</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
